{
  "version": 1,
  "credentialsFile": ".env/.env.deploy",
  "keyFile": ".project-config.key",
  "manifestDirectory": ".external-lfs/manifests",
  "targets": {
    "release-oss": {
      "provider": "aliyun-oss",
      "remotePrefix": "android-smb/private-files/v1",
      "env": {
        "region": "OSS_RELEASE_REGION",
        "endpoint": "OSS_RELEASE_ENDPOINT",
        "bucket": "OSS_RELEASE_BUCKET",
        "accessKeyId": "OSS_RELEASE_ACCESS_KEY_ID",
        "accessKeySecret": "OSS_RELEASE_ACCESS_KEY_SECRET"
      }
    }
  },
  "managedPaths": [{ "path": "private", "scope": "release" }],
  "exclude": ["**/.DS_Store", "**/*.tmp", "**/.gitkeep"]
}
